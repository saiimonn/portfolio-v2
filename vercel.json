{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "saiimonn.vercel.app" }],
      "destination": "https://saiimonn.xaria.dev/$1",
      "permanent": true
    }
  ]
}
